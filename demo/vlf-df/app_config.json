{
  "figureProps": {
    "Name": "VLF-DF"
  },
  "tabs": [
      {
          "title": "Channels",
          "components": [
              {"type": "axes", "tag": "axesCh1Waveform", "row": 1, "col": [1,2]},
              {"type": "axes", "tag": "axesCh1FFT", "row": 1, "col": [3,4]},
              {"type": "axes", "tag": "axesCh2Waveform", "row": 2, "col": [1,2]},
              {"type": "axes", "tag": "axesCh2FFT", "row": 2, "col": [3,4]},
              {"type": "axes", "tag": "axesCh3Waveform", "row": 3, "col": [1,2]},
              {"type": "axes", "tag": "axesCh3FFT", "row": 3, "col": [3,4]},
              {"type": "axes", "tag": "axesCh4Waveform", "row": 4, "col": [1,2]},
              {"type": "axes", "tag": "axesCh4FFT", "row": 4, "col": [3,4]}
          ]
      },
      {
          "title": "Panorama",
          "components": [
              {"type": "axes",  "tag": "axesPanorama",  "row": 1,     "col": [1,4]},
              {"type": "image", "tag": "imagePanorama", "row": [2,3], "col": [1,4]},
              {"type": "slider","tag": "sliderFrequencyLow",  "text": "Adjust Lower Frequency", "row": 4, "col": 1, "callbackName": "handleSlider"},
              {"type": "slider","tag": "sliderFrequencyHigh", "text": "Adjust Upper Frequency", "row": 4, "col": 2, "callbackName": "handleSlider"}
          ]
      },
      {
          "title": "NAA",
          "components": [
              {"type": "axes",  "tag": "axesNAAfft",  "row": 1,     "col": [1,2]},
              {"type": "axes",  "tag": "axesNAAref",  "row": [2,3],  "col": [1,2]},
              {"type": "axes",  "tag": "axesNAAhst",  "row": [1,2],  "col": [3,4]}
          ]
      },



    {
      "title": "Plot Tab",
      "components": [
        {"type": "button", "text": "Generate Plot Data", "row": 1, "col": 1, "callbackName": "handlePlotButton"},
        {"type": "axes", "tag": "mainAxes", "row": 2, "col": [1, 3]},
        {"type": "slider", "tag": "ampSlider", "text": "Adjust Amplitude", "row": 1, "col": 2, "callbackName": "handleSlider"},
        {"type": "checkbox", "text": "Show Grid", "row": 1, "col": 3, "callbackName": "handleCheckbox"},
        {"type": "textarea", "tag": "logArea", "text": "App Log Area:\n", "row": 3, "col": [1, 3]}
      ]
    },
    {
      "title": "Info Tab",
      "components": [
        {"type": "text", "text": "This tab contains general information.", "row": 1, "col": 1}
      ]
    },

    {
      "title": "Visual Tab",
      "components": [
        {"type": "led", "tag": "led_mask", "text": "Mask", "row": 1, "col": 1},
        {"type": "led", "tag": "led_reference", "text": "Reference", "row": 1, "col": 3},
          {"type": "toggleswitch", "tag": "toggleswitch_mask_update_3", "text": "mask 3 update", "row": 4, "col": 3, "callbackName": "handle_toggleswitch_mask_update_3"},
          {"type": "toggleswitch", "tag": "toggleswitch_mask_reset_3" , "text": "mask 3 reset", "row": 4, "col": 4, "callbackName": "handle_toggleswitch_mask_reset_3"},
          {"type": "toggleswitch", "tag": "toggleswitch_mask_update_2", "text": "mask 2 update", "row": 3, "col": 3, "callbackName": "handle_toggleswitch_mask_update_2"},
          {"type": "toggleswitch", "tag": "toggleswitch_mask_reset_2" , "text": "mask 2 reset", "row": 3, "col": 4, "callbackName": "handle_toggleswitch_mask_reset_2"},
          {"type": "toggleswitch", "tag": "toggleswitch_mask_update_1", "text": "mask 1 update", "row": 2, "col": 3, "callbackName": "handle_toggleswitch_mask_update_1"},
          {"type": "toggleswitch", "tag": "toggleswitch_mask_reset_1" , "text": "mask 1 reset", "row": 2, "col": 4, "callbackName": "handle_toggleswitch_mask_reset_1"},
          {"type": "toggleswitch", "tag": "toggleswitch_reference_1", "text": "ref 1 set", "row": 2, "col": 2, "callbackName": "handle_toggleswitch_reference_1"},
          {"type": "toggleswitch", "tag": "toggleswitch_reference_2", "text": "ref 2 set", "row": 3, "col": 2, "callbackName": "handle_toggleswitch_reference_2"},
          {"type": "toggleswitch", "tag": "toggleswitch_reference_3", "text": "ref 3 set", "row": 4, "col": 2, "callbackName": "handle_toggleswitch_reference_3"},
          {"type": "toggleswitch", "tag": "toggleswitch_run_stop", "text": "STOP", "row": 3, "col": 1, "callbackName": "handle_toggleswitch_run_stop"}
      ]
    }
  ]
}
